# Required: generate a long, random value and never commit the real secret.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public URL currently routed through Cloudflare to the home-lab container.
SITE_URL=https://uccelli.qrwed.uk

# Local development database. Docker Compose overrides this with /app/data.
DATABASE_URI=file:./data/uccelli.db

# Optional integrations.
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
