# Required: generate a long, random value and never commit the real secret.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Home-server CMS URL.
SITE_URL=https://uccelli-society.ch
ADMIN_ORIGIN=https://cms.uccelli-society.ch

# Local Payload database used only by the home-server CMS.
DATABASE_URI=file:./data/uccelli.db

# Optional integrations.
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare publication sync.
# Keep the real token outside the repository, preferably in /etc/uccelli-cloud-sync.env.
CLOUDFLARE_API_TOKEN=
UCCELLI_D1_DATABASE=uccelli-prod
UCCELLI_R2_BUCKET=uccelli-media
UCCELLI_DB_PATH=/opt/uccelli-website/data/uccelli.db
UCCELLI_MEDIA_DIR=/opt/uccelli-website/media
